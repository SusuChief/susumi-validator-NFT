{
  "name": "susumi-smart-contracts",
  "version": "1.0.0",
  "description": "Susumi Pioneer NFT Smart Contracts built with Hardhat",
  "main": "index.js",
  "scripts": {
    "test": "npx hardhat test",
    "compile": "npx hardhat compile",
    "deploy:mocks": "npx hardhat run scripts/deploy/00_deploy_mocks.js --network",
    "deploy:nft": "npx hardhat run scripts/deploy/01_deploy_nft_contract.js --network",
    "deploy:launchpad": "npx hardhat run scripts/deploy/02_deploy_launchpad_contract.js --network",
    "deploy:all": "npm run deploy:mocks && npm run deploy:nft && npm run deploy:launchpad",
    "verify": "npx hardhat verify"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.8",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.12",
    "@nomicfoundation/hardhat-verify": "^2.0.12",
    "@openzeppelin/contracts": "^5.0.1",
    "@openzeppelin/contracts-upgradeable": "^5.0.1",
    "@openzeppelin/hardhat-upgrades": "^3.6.0",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "chai": "^4.5.0",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.4",
    "hardhat": "^2.22.17",
    "hardhat-abi-exporter": "^2.10.1",
    "hardhat-contract-sizer": "^2.10.0",
    "hardhat-gas-reporter": "^2.2.2",
    "typechain": "^8.3.2"
  }
}
